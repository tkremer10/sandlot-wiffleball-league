<style>
:root{--primary:#53b9d3;--dark:#10263f;--accent:#fff1c4;--ink:#172033;--muted:#667187;--paper:#fffdf9;--line:#e5e8ed}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',sans-serif;background:#f6f3ed;color:var(--ink);line-height:1.5}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}.wrap{width:min(1120px,calc(100% - 36px));margin:auto}
.topbar{background:#0a1220;color:#c9d0de;padding:9px 0;font-size:11px;letter-spacing:.13em;text-transform:uppercase}.topbar .wrap{display:flex;justify-content:space-between;gap:12px}.header{background:#111b2b;color:white;border-bottom:1px solid #ffffff20}.nav{min-height:77px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:14px}.brand img{width:90px;height:58px;object-fit:contain}.brand strong{font-size:13px;letter-spacing:.06em;display:block}.brand small{display:block;font-size:10px;letter-spacing:.14em;color:#a8b3c4}.navlinks{display:flex;gap:19px;align-items:center;flex-wrap:wrap;font-size:12px;font-weight:750}.navlinks a:hover{color:var(--primary)}
.hero{background:linear-gradient(125deg,var(--dark),#20334b);color:#fff;position:relative;overflow:hidden}.hero:after{content:'SR';position:absolute;right:-.06em;bottom:-.3em;font-size:clamp(200px,36vw,500px);font-weight:1000;line-height:1;opacity:.05;pointer-events:none}.hero .wrap{position:relative;z-index:1;display:flex;align-items:center;gap:35px;min-height:310px;padding:56px 0}.logo-frame{width:185px;height:185px;flex:0 0 185px;display:grid;place-items:center;background:#ffffff12;border:1px solid #ffffff30;border-radius:30px;box-shadow:0 18px 45px #0003;overflow:hidden}.logo-frame img{width:94%;height:94%;object-fit:contain}.logo-fallback{font-size:70px;font-weight:1000;color:var(--primary);letter-spacing:-.08em}.kicker{color:var(--primary);font-size:11px;font-weight:950;text-transform:uppercase;letter-spacing:.18em}h1{font-size:clamp(46px,7vw,82px);line-height:1;margin:10px 0 15px;letter-spacing:-.065em}.hero p{font-size:17px;color:#d3dce9;max-width:540px;margin:0 0 23px}.actions{display:flex;gap:10px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:9px;padding:12px 17px;font-size:12px;font-weight:900;border:1px solid #ffffff50}.btn.primary{background:var(--primary);color:var(--dark);border-color:var(--primary)}.btn.secondary{color:white}.btn:hover{filter:brightness(1.08)}
.stripe{height:8px;background:linear-gradient(90deg,var(--primary) 0 65%,var(--accent) 65% 100%)}section{padding:64px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:23px}.section-head h2{font-size:clamp(28px,4vw,42px);margin:5px 0 0;letter-spacing:-.05em}.section-head p{font-size:13px;color:var(--muted);margin:0;max-width:370px}.section-label{font-size:10px;color:#a63e57;text-transform:uppercase;letter-spacing:.16em;font-weight:900}.roster{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.player{display:flex;align-items:center;gap:15px;padding:16px;border-radius:14px;background:white;border:1px solid var(--line);box-shadow:0 8px 25px #1018270a;min-width:0;transition:transform .2s,box-shadow .2s}.player:hover{transform:translateY(-2px);box-shadow:0 14px 30px #10182718}.player-photo{width:68px;height:68px;flex:0 0 68px;border-radius:12px;background:var(--dark);color:var(--primary);display:grid;place-items:center;overflow:hidden;font-size:23px;font-weight:950}.player-photo img{width:100%;height:100%;object-fit:cover}.player-data{min-width:0}.player-name{font-size:15px;font-weight:900;line-height:1.2;overflow-wrap:anywhere}.player-hometown{color:var(--muted);font-size:11px;margin-top:5px}.player-number{color:#9b5269;font-size:10px;font-weight:900;letter-spacing:.12em;margin-bottom:4px}.status{padding:19px;background:#fff;border:1px solid var(--line);border-radius:12px;color:var(--muted);font-size:13px}.status.error{color:#a32338}.small-note{font-size:12px;color:var(--muted);margin-top:18px}.info{background:#fff;border-top:1px solid var(--line)}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.info-card{background:#f7f8fb;border:1px solid var(--line);padding:25px;border-radius:14px}.info-card h3{margin:0 0 10px;font-size:18px}.info-card p{margin:0;color:var(--muted);font-size:13px}.footer{background:#0b1220;color:white;padding:32px 0}.footer .wrap{display:flex;align-items:center;justify-content:space-between;gap:15px}.footer p{color:#9eabba;font-size:11px;margin:4px 0}.footer a{font-size:12px;font-weight:800;color:var(--primary)}
@media(max-width:850px){.roster{grid-template-columns:repeat(2,minmax(0,1fr))}.hero .wrap{gap:22px}.logo-frame{width:135px;height:135px;flex-basis:135px}.logo-fallback{font-size:48px}}
@media(max-width:580px){.topbar .wrap{font-size:9px}.brand img{width:65px;height:46px}.brand strong{font-size:11px}.navlinks{gap:10px;font-size:11px}.navlinks a:nth-child(2){display:none}.hero .wrap{flex-direction:column;align-items:flex-start;padding:35px 0 44px;min-height:0}.logo-frame{width:112px;height:112px;flex-basis:112px;border-radius:20px}.hero h1{font-size:48px}.hero p{font-size:14px}section{padding:45px 0}.section-head{display:block}.section-head p{margin-top:10px}.roster{grid-template-columns:1fr}.info-grid{grid-template-columns:1fr}.footer .wrap{display:block}}
</style>
</head>
<body>
<div class="topbar"><div class="wrap"><span>Official SWL Team Headquarters</span><span>Est. 2022</span></div></div>
<header class="header"><div class="wrap nav"><a class="brand" href="index.html" aria-label="SWL homepage"><img src="swl-logo.png" alt="SWL logo"><span><strong>SANDLOT WIFFLE BALL</strong><small>LEAGUE</small></span></a><nav class="navlinks" aria-label="Main navigation"><a href="index.html#teams">All Teams</a><a href="index.html#standings">Standings</a><a href="index.html#stats">Stats</a><a href="/gamecenter/">GameCenter</a></nav></div></header>
<div class="stripe"></div>
<main>
<section class="hero"><div class="wrap"><div class="logo-frame" id="teamLogo"><img src="sea-robbers-logo.png" alt="Sea Robbers official logo" onerror="this.remove();this.parentElement.textContent='SR';this.parentElement.classList.add('logo-fallback')"></div><div><div class="kicker">Sandlot Wiffle Ball League · Team Profile</div><h1>SEA ROBBERS</h1><p>Rule the sandlot seas. All aboard for a new era.</p><div class="actions"><a class="btn primary" href="#roster">VIEW THE ROSTER ↓</a><a class="btn secondary" href="index.html#teams">ALL SWL TEAMS ↗</a></div></div></div></section>
<section id="roster"><div class="wrap"><div class="section-head"><div><div class="section-label">Meet the squad</div><h2>Official Team Roster</h2></div><p>Active players are pulled directly from SWL GameCenter and updated when the league roster changes.</p></div><div id="rosterStatus" class="status" role="status" aria-live="polite">Loading the Sea Robbers roster…</div><div id="rosterGrid" class="roster" aria-label="Sea Robbers active roster"></div><p class="small-note">Player numbers, hometowns, and photos appear when available in the official player database.</p></div></section>
<section class="info"><div class="wrap info-grid"><div class="info-card"><h3>About the Sea Robbers</h3><p>The Sea Robbers are part of the Sandlot Wiffle Ball League. Follow the team roster and league results as the next season takes shape.</p></div><div class="info-card"><h3>Follow the action</h3><p>See standings, player statistics, and the latest SWL game updates.</p><p style="margin-top:14px"><a href="index.html#standings" style="font-weight:900;color:#b33245">LEAGUE STANDINGS →</a></p></div></div></section>
</main>
<footer class="footer"><div class="wrap"><div><strong>SANDLOT WIFFLE BALL LEAGUE</strong><p>Community. Competition. Sandlot.</p></div><a href="index.html">BACK TO SWL HOME →</a></div></footer>
<script>
const API_URL='https://swl-gamecenter-api.sandlotwiffleball-2022.workers.dev/api/public';
const TEAM_NAME='Sea Robbers';
const normalize=s=>String(s??'').toLowerCase().replace(/[^a-z0-9]/g,'');
const rosterGrid=document.getElementById('rosterGrid');
const rosterStatus=document.getElementById('rosterStatus');
function text(value){return String(value??'').trim();}
function initials(name){return text(name).split(/\s+/).map(w=>w.charAt(0)).slice(0,2).join('').toUpperCase()||'?';}
function playerCard(player){
 const id=text(player.id||player.playerId);
 const url=new URL('player.html',location.href);
 if(id)url.searchParams.set('id',id);
 url.searchParams.set('name',text(player.name));
 url.searchParams.set('team',text(player.teamId));
 const a=document.createElement('a');a.className='player';a.href=url.href;a.title='View '+text(player.name)+' player profile';
 const photo=document.createElement('div');photo.className='player-photo';photo.textContent=initials(player.name);
 const photoUrl=text(player.photoUrl||player.PhotoURL||player.photoURL);
 if(photoUrl&&/^https?:\/\//i.test(photoUrl)){const img=document.createElement('img');img.src=photoUrl;img.alt=text(player.name);img.loading='lazy';img.onerror=()=>img.remove();photo.replaceChildren(img);}
 const info=document.createElement('div');info.className='player-data';
 const number=document.createElement('div');number.className='player-number';number.textContent=text(player.number)?'#'+text(player.number):'SWL PLAYER';
 const name=document.createElement('div');name.className='player-name';name.textContent=text(player.name)||'Unnamed Player';
 const hometown=document.createElement('div');hometown.className='player-hometown';hometown.textContent=text(player.hometown)||'Hometown not listed';
 info.append(number,name,hometown);a.append(photo,info);return a;
}
async function loadRoster(){
 rosterStatus.hidden=false;rosterStatus.className='status';rosterStatus.textContent='Loading the '+TEAM_NAME+' roster…';rosterGrid.replaceChildren();
 try{
  const controller=new AbortController();const timeout=setTimeout(()=>controller.abort(),15000);
  let response;
  try{response=await fetch(API_URL,{signal:controller.signal,cache:'no-store'});}finally{clearTimeout(timeout);}
  if(!response.ok)throw new Error('GameCenter returned '+response.status);
  const data=await response.json();
  if(!Array.isArray(data.teams)||!Array.isArray(data.players))throw new Error('Invalid roster data');
  const team=data.teams.find(t=>normalize(t.name)===normalize(TEAM_NAME));
  if(!team){rosterStatus.textContent='This team has not yet been added to the GameCenter Teams sheet. The roster will appear automatically once the team is registered.';return;}
  const players=data.players.filter(p=>String(p.teamId)===String(team.id)).sort((a,b)=>text(a.name).localeCompare(text(b.name)));
  if(!players.length){rosterStatus.textContent='No active players are listed for the '+TEAM_NAME+' yet. Check back as the roster is announced.';return;}
  const fragment=document.createDocumentFragment();players.forEach(p=>fragment.append(playerCard(p)));rosterGrid.append(fragment);rosterStatus.hidden=true;
 }catch(error){console.error('SWL roster error',error);rosterStatus.className='status error';rosterStatus.textContent='Roster temporarily unavailable. Please refresh this page to try again.';}
}
loadRoster();
</script>
</body>
</html>
